# ========== Makers AI 网关（本地调试 / 线上环境变量） ==========
# 获取路径：EdgeOne Makers 控制台 → 模型与密钥 → API Key
# 说明：遵循 OpenAI 兼容协议，也可换成任意兼容服务商的 Key 与 Base URL
AI_GATEWAY_API_KEY=your-makers-api-key
AI_GATEWAY_BASE_URL=https://ai-gateway.edgeone.link/v1
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash

# ========== 高德开放平台 Web 服务 Key ==========
# 获取路径：https://console.amap.com/ → 应用管理 → 创建应用 → 添加 Key
# 注意：服务平台必须选「Web 服务」，不是 Web 端(JS API) / Android / iOS
AMAP_API_KEY=your-amap-web-service-key
